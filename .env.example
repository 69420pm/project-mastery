# Copy to .env.local and fill in values. Never commit real secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- App ---
# Public origin of the app, without a trailing slash. Optional: on Vercel it
# defaults to the deployment URL, locally to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI ---
# Where model calls go: "gateway" (Vercel AI Gateway, the default, also for local
# development). "mock" answers every call with a deterministic streamed reply
# and no network access; the Playwright suite runs with it. Refused on Vercel.
AI_PROVIDER=gateway
# An AI Gateway API key (Vercel dashboard > AI Gateway > API Keys); every team
# gets a monthly free credit. On Vercel, OIDC authenticates automatically and
# no key is needed. Use your own test materials, never personal data.
AI_GATEWAY_API_KEY=
# Optional per-task model overrides (gateway model ids like openai/gpt-5-nano,
# priced in src/lib/ai/prices.ts), see src/lib/ai/models.ts.
AI_MODEL_CHAT=
AI_MODEL_TITLE=
AI_MODEL_INGEST=
AI_MODEL_MAP=
AI_MODEL_EXERCISE=
AI_MODEL_EMBED=
AI_MODEL_JUDGE=
# Daily limit per Student in US dollars, e.g. 0.50: their AI spend since 00:00
# UTC, priced from src/lib/ai/prices.ts in every provider mode. From 80% the
# Chat shows a notice; at the limit AI calls are refused until 00:00 UTC.
# Empty means no limit, which suits local development. Set it on deployments.
AI_DAILY_LIMIT_USD=

# --- LLM tracing and evals (Langfuse, optional) ---
# Without keys, tracing is off and `pnpm evals` only prints its results.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Supabase (database, auth, storage) ---
# Local: `pnpm db:start` runs Supabase in Docker. `pnpm db:status` prints the
# values below: "Project URL", "Publishable" key and "Secret" key. The local
# keys are fixed development defaults and only work against the local stack.
# Hosted: Project Settings > API Keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# sb_publishable_... (a legacy anon JWT also works). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# sb_secret_... (a legacy service_role JWT also works). Server only: bypasses
# Row Level Security. Only needed by code that uses createAdminClient().
SUPABASE_SECRET_KEY=sb_secret_your-key
