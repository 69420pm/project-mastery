# Copy to .env.local and fill in values. Never commit real secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- App ---
# Public origin of the app, without a trailing slash. Optional: on Vercel it
# defaults to the deployment URL, locally to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI ---
# Where model calls go: "google" (Gemini API directly, local development only)
# or "gateway" (Vercel AI Gateway, the default and the only option on Vercel).
# "mock" answers every call with a deterministic streamed reply and no network
# access; the Playwright suite runs with it. Refused on Vercel.
AI_PROVIDER=google
# AI_PROVIDER=google: a Gemini API key from Google AI Studio
# (https://aistudio.google.com/apikey). The free tier needs no credit card.
# Google may use free-tier prompts for training and human review: use your own
# test materials, never personal data.
GOOGLE_GENERATIVE_AI_API_KEY=
# AI_PROVIDER=gateway: an AI Gateway API key (Vercel dashboard > AI Gateway >
# API Keys). On Vercel, OIDC authenticates automatically and no key is needed.
AI_GATEWAY_API_KEY=
# Optional per-task model overrides (gateway model ids like google/gemini-3.8-flash,
# only google/ models with AI_PROVIDER=google), see src/lib/ai/models.ts.
AI_MODEL_CHAT=
AI_MODEL_TITLE=
AI_MODEL_INGEST=
AI_MODEL_EMBED=
AI_MODEL_JUDGE=

# --- LLM tracing and evals (Langfuse, optional) ---
# Without keys, tracing is off and `pnpm evals` only prints its results.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Supabase (database, auth, storage) ---
# Local: `pnpm db:start` runs Supabase in Docker. `pnpm db:status` prints the
# values below: "Project URL", "Publishable" key and "Secret" key. The local
# keys are fixed development defaults and only work against the local stack.
# Hosted: Project Settings > API Keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# sb_publishable_... (a legacy anon JWT also works). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# sb_secret_... (a legacy service_role JWT also works). Server only: bypasses
# Row Level Security. Only needed by code that uses createAdminClient().
SUPABASE_SECRET_KEY=sb_secret_your-key
