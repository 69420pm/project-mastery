{
  "source": "Chapter 7 · The Physics and Engineering of Jet Engines (pp. 185–189)",
  "bigIdeas": [
    {
      "id": "BI1",
      "name": "Thrust from momentum",
      "description": "Every jet engine makes thrust by accelerating air rearward; the thrust equation quantifies it."
    },
    {
      "id": "BI2",
      "name": "Turbojet anatomy",
      "description": "Five sections in flow order, each with one job; the turbine powers the compressor."
    },
    {
      "id": "BI3",
      "name": "Brayton cycle & thermal efficiency",
      "description": "The ideal four-process cycle; efficiency depends only on pressure ratio and γ."
    },
    {
      "id": "BI4",
      "name": "Propulsive efficiency & engine families",
      "description": "Large mass flow at small velocity increment wastes less energy; this explains which architecture fits which flight regime."
    }
  ],
