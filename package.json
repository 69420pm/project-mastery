{
  "name": "project-mastery",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Project Mastery",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "e2e/build-if-stale.sh && playwright test",
    "evals": "tsx --conditions=react-server --env-file-if-exists=.env.local evals/run.ts",
    "evals:export-generate": "tsx --conditions=react-server --env-file-if-exists=.env.local evals/smoke/export-generate.ts",
    "evals:report": "tsx --conditions=react-server --env-file-if-exists=.env.local evals/report-cli.ts",
    "metrics": "tsx --conditions=react-server --env-file-if-exists=.env.local evals/metrics-cli.ts",
    "langfuse:models": "tsx --env-file-if-exists=.env.local evals/langfuse-models.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test:run",
    "prepare": "husky",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migration:new": "supabase migration new",
    "db:types": "supabase gen types --local --schema public > src/lib/supabase/database.types.ts && prettier --write --log-level=warn src/lib/supabase/database.types.ts",
    "db:lint": "supabase db lint --local --fail-on error",
    "db:test": "supabase test db",
    "agent": "tsx --env-file-if-exists=.env.local tools/agent/cli.ts",
    "gold": "tsx --conditions=react-server --env-file-if-exists=.env.local evals/smoke/gold-cli.ts",
    "smoke": "tsx --conditions=react-server --env-file-if-exists=.env.local evals/smoke.ts",
    "retro": "tsx tools/retro/cli.ts",
    "sweep": "tsx tools/sweep/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.101",
    "@ai-sdk/react": "^4.0.151",
    "@langfuse/client": "^6.0.1",
    "@langfuse/otel": "^6.0.1",
    "@langfuse/tracing": "^6.0.1",
    "@langfuse/vercel-ai-sdk": "^6.0.1",
    "@napi-rs/canvas": "catalog:",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.147",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "elkjs": "~0.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.60.0",
    "mathjs": "^15.2.0",
    "motion": "^14.4.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "^11.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "ts-fsrs": "5.4.2",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.9.1",
    "use-stick-to-bottom": "^1.1.6",
    "workflow": "^5.2.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "agent-browser": "^0.39.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "jscpd": "5.4.2",
    "jsdom": "^30.1.3",
    "knip": "6.42.1",
    "lint-staged": "^17.6.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
